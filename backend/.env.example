# Copie para .env na mesma pasta (backend) e ajuste se precisar.
DATABASE_URL=sqlite:///./scge.db
SECRET_KEY=change_this_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (when migrating):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/scge
